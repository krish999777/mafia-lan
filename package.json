{
  "name": "mafia-lan",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "LAN Mafia — Offline Multiplayer Mafia Game",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=server",
